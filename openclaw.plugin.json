{
  "id": "openclaw-travel-companion",
  "name": "OpenClaw Travel Companion",
  "description": "A travel-frog-style companion plugin with bundled skills, Gemini grounding, and autonomous postcard delivery.",
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "geminiApiKey": {
        "type": "string"
      },
      "openrouterApiKey": {
        "type": "string"
      },
      "defaultOriginCity": {
        "type": "string"
      },
      "pollIntervalSeconds": {
        "type": "integer",
        "minimum": 15,
        "maximum": 3600
      },
      "openclawBinaryPath": {
        "type": "string"
      },
      "planningModel": {
        "type": "string"
      },
      "textModel": {
        "type": "string"
      },
      "imageModel": {
        "type": "string"
      },
      "geminiBaseUrl": {
        "type": "string"
      },
      "openrouterBaseUrl": {
        "type": "string"
      }
    }
  },
  "uiHints": {
    "geminiApiKey": {
      "label": "Gemini API Key",
      "placeholder": "AIza...",
      "sensitive": true
    },
    "openrouterApiKey": {
      "label": "OpenRouter API Key",
      "placeholder": "sk-or-v1-...",
      "sensitive": true
    },
    "defaultOriginCity": {
      "label": "Default Origin City",
      "placeholder": "Hong Kong"
    },
    "pollIntervalSeconds": {
      "label": "Poll Interval Seconds",
      "help": "How often the background service scans for due trip steps."
    },
    "openclawBinaryPath": {
      "label": "OpenClaw Binary Path",
      "placeholder": "openclaw"
    },
    "planningModel": {
      "label": "Planning Model",
      "placeholder": "gemini-3-flash-preview"
    },
    "textModel": {
      "label": "Caption and Grounding Model",
      "placeholder": "gemini-3-flash-preview"
    },
    "imageModel": {
      "label": "Image Model",
      "placeholder": "gemini-3.1-flash-image-preview"
    },
    "geminiBaseUrl": {
      "label": "Gemini Base URL",
      "placeholder": "https://generativelanguage.googleapis.com/v1beta"
    },
    "openrouterBaseUrl": {
      "label": "OpenRouter Base URL",
      "placeholder": "https://openrouter.ai/api/v1"
    }
  }
}
