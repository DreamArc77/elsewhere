{
  "name": "@dreamarc/elsewhere",
  "version": "1.0.5",
  "private": false,
  "type": "module",
  "description": "elsewhere is an OpenClaw companion plugin with guided onboarding, travel postcards, delayed replies, and image generation.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "travel",
    "companion",
    "telegram",
    "wechat",
    "qq",
    "feishu"
  ],
  "homepage": "https://github.com/DreamArc77/elsewhere",
  "bugs": {
    "url": "https://github.com/DreamArc77/elsewhere/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamArc77/elsewhere.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "plugin.ts",
    "src",
    "prompts",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "openclaw": {
    "extensions": [
      "./plugin.ts"
    ],
    "install": {
      "npmSpec": "@dreamarc/elsewhere",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.3.28"
    },
    "compat": {
      "pluginApi": ">=2026.3.28",
      "minGatewayVersion": "2026.3.28"
    },
    "build": {
      "openclawVersion": "2026.3.28",
      "pluginSdkVersion": "2026.3.28"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "saas:dev": "node dist/apps/saas/src/index.js",
    "release:check": "node scripts/release-check.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:publish:dry-run": "node scripts/release-publish.mjs --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run tests/live.gemini.smoke.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "openclaw": "^2026.4.9",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
